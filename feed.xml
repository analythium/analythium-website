---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ '/' | absolute_url | xml_escape }}</link>
    <atom:link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/rss+xml" />
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {% for post in site.posts %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url | xml_escape }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url | xml_escape }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      {% if post.author %}<author>{{ post.author | xml_escape }}</author>{% endif %}
      {% if post.tags %}{% for tag in post.tags %}<category>{{ tag | xml_escape }}</category>{% endfor %}{% endif %}
      <description>{{ post.excerpt | strip_html | normalize_whitespace | xml_escape }}</description>
      <content:encoded>{{ post.content | xml_escape }}</content:encoded>
    </item>
    {% endfor %}
  </channel>
</rss>